# --- DeepSeek (the sales agent's brain, OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- WhatsApp Cloud API (Meta) ---
# Buat di business.facebook.com > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=isi-string-bebas-untuk-verifikasi-webhook

# --- Instagram Messaging API (Meta) ---
# Page Access Token dari Facebook Page yang terhubung ke akun Instagram Business
IG_PAGE_ACCESS_TOKEN=
IG_VERIFY_TOKEN=isi-string-bebas-untuk-verifikasi-webhook

PORT=3000
